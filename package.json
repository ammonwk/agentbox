{
  "name": "agentbox",
  "version": "0.1.0",
  "description": "Spawning and maintaining omp sessions — a board over your agents",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "build": "bun run web:build",
    "typecheck": "tsc --noEmit",
    "doctor": "bun bin/agentbox doctor"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
