#!/usr/bin/env bun
// A shim, deliberately. This file has no extension, so `tsc` skips it whatever
// the `include` globs say — which is how a correct paths.ts refactor shipped a
// boot-time SyntaxError past a clean typecheck, a full test run and a green UI
// build. Every line of logic lives in src/cli/index.ts where the typechecker
// can see it. Do not grow this file.
import { main } from "../src/cli/index";

const code = await main(process.argv.slice(2));
// `null` means the command is still running (serve, mcp); exiting would kill it.
if (code !== null) process.exit(code);
