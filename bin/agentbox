#!/usr/bin/env bun
/**
 * agentbox CLI — thin wrapper around the server.
 *
 *   agentbox            start the server (default)
 *   agentbox doctor     check that everything it needs is installed
 *   agentbox version    print the version
 */
import { run } from "../src/core/git";
import { AGENTBOX_HOME, DEFAULT_PORT, ensureDirs } from "../src/core/paths";
import { getDb } from "../src/core/db";
import { ompAvailable } from "../src/core/sessions";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const OPCODE_CONFIG = join(homedir(), ".config", "opencode", "opencode.jsonc");
const AGENTBOX_ROOT = new URL("..", import.meta.url).pathname;

function mcpEntry(): string {
  return [
    '    "agentbox": {',
    '      "type": "local",',
    '      "command": [',
    `        "bun",`,
    `        ${JSON.stringify(join(AGENTBOX_ROOT, "bin", "agentbox"))},`,
    '        "mcp"',
    "      ]",
    "    },",
  ].join("\n");
}

function installMcp() {
  if (!existsSync(OPCODE_CONFIG)) {
    console.log(`✗ opencode config not found at ${OPCODE_CONFIG}`);
    process.exit(1);
  }
  const raw = readFileSync(OPCODE_CONFIG, "utf8");
  if (raw.includes('"agentbox"')) {
    console.log("agentbox MCP already registered in opencode.");
    return;
  }
  const marker = '"mcp": {';
  const idx = raw.indexOf(marker);
  if (idx === -1) {
    console.log("✗ could not find the mcp section in opencode config");
    process.exit(1);
  }
  const insertAt = idx + marker.length;
  const next = raw.slice(0, insertAt) + "\n" + mcpEntry() + raw.slice(insertAt);
  writeFileSync(OPCODE_CONFIG, next);
  console.log(`✓ registered agentbox MCP in ${OPCODE_CONFIG}\n  Restart opencode for it to take effect.`);
}

function uninstallMcp() {
  if (!existsSync(OPCODE_CONFIG)) return;
  const raw = readFileSync(OPCODE_CONFIG, "utf8");
  const start = raw.indexOf('    "agentbox": {');
  if (start === -1) {
    console.log("agentbox MCP not registered.");
    return;
  }
  const end = raw.indexOf("\n    },", start);
  const next = raw.slice(0, start) + raw.slice(end === -1 ? start : end + "\n    },".length);
  writeFileSync(OPCODE_CONFIG, next);
  console.log("✓ removed agentbox MCP from opencode config");
}

const args = process.argv.slice(2);
const cmd = args[0] ?? "serve";

async function doctor() {
  ensureDirs();
  const checks: { name: string; ok: boolean; detail: string }[] = [
    { name: "data dir", ok: true, detail: AGENTBOX_HOME },
    { name: "omp", ok: ompAvailable(), detail: ompAvailable() ? `found omp` : "NOT FOUND on PATH (install via omp.sh)" },
  ];
  for (const tool of ["git", "gh", "tmux"]) {
    const r = run(["sh", "-lc", `command -v ${tool}`]);
    checks.push({ name: tool, ok: r.code === 0, detail: r.stdout.trim() || "missing" });
  }
  const settings = getDb().query("SELECT count(*) as n FROM repos").get() as { n: number };
  checks.push({ name: "repos", ok: true, detail: `${settings.n} registered` });

  let bad = 0;
  for (const c of checks) {
    console.log(`${c.ok ? "✓" : "✗"} ${c.name}: ${c.detail}`);
    if (!c.ok) bad++;
  }
  console.log(`\nagentbox home: ${AGENTBOX_HOME}`);
  console.log(bad === 0 ? "All good." : `${bad} problem(s) — fix before running.`);
  process.exit(bad === 0 ? 0 : 1);
}

switch (cmd) {
  case "doctor":
    await doctor();
    break;
  case "version":
    console.log("agentbox 0.1.0");
    break;
  case "mcp":
    await import("../src/mcp/index");
    break;
  case "install":
    ensureDirs();
    installMcp();
    break;
  case "uninstall":
    uninstallMcp();
    break;
  default:
    console.log(`agentbox: starting on http://127.0.0.1:${DEFAULT_PORT}`);
    ensureDirs();
    await import("../src/server/index");
    break;
}
